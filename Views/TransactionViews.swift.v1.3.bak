struct TransactionRow: View {
    let transaction: Transaction
    @EnvironmentObject var viewModel: FinanceViewModel
    @State private var showingEdit = false
    @State private var showAlert = false
    @State private var alertMessage = ""
    @Binding var selectedTab: Int
    var navigateToGastosDiarios: Binding<Bool>? = nil
    var navigateToPropinas: Binding<Bool>? = nil
    
    private func formatDate(_ date: Date) -> String {
        let formatter = DateFormatter()
        formatter.locale = Locale(identifier: "es_ES")
        formatter.dateFormat = "MMM yyyy"
        return formatter.string(from: date)
    }
    
    var body: some View {
        HStack(spacing: 8) {
            if transaction.type != .tips && transaction.type != .gp {
            Button(action: {
                    let result = viewModel.toggleTransactionCompletion(transaction)
                    if !result.success, let message = result.message {
                        alertMessage = message
                        showAlert = true
                    }
            }) {
                Image(systemName: transaction.isCompleted ? "checkmark.circle.fill" : "circle")
                    .foregroundColor(transaction.isCompleted ? .green : .gray)
                    .frame(width: 20, height: 20)
            }
            .buttonStyle(PlainButtonStyle())
                .alert(isPresented: $showAlert) {
                    Alert(
                        title: Text("Acción no permitida"),
                        message: Text(alertMessage),
                        dismissButton: .default(Text("Entendido"))
                    )
                }
            }
            
            Button(action: { 
                if transaction.type == .tips {
                    withAnimation {
                        selectedTab = 3 // Navegar a la pestaña Más
                        // Primero desactivamos para asegurar que se active correctamente después
                        navigateToPropinas?.wrappedValue = false
                        DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) {
                            navigateToPropinas?.wrappedValue = true
                        }
                    }
                } else if transaction.concept == "Gastos Diarios" {
                    withAnimation {
                        selectedTab = 3 // Navegar a la pestaña Más
                        // Primero desactivamos para asegurar que se active correctamente después
                        navigateToGastosDiarios?.wrappedValue = false
                        DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) {
                            navigateToGastosDiarios?.wrappedValue = true
                        }
                    }
                } else if transaction.concept == "Propinas" {
                    // Para la transacción representativa de Propinas en la lista de ingresos
                    withAnimation {
                        selectedTab = 3 // Navegar a la pestaña Más
                        // Primero desactivamos para asegurar que se active correctamente después
                        navigateToPropinas?.wrappedValue = false
                        DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) {
                            navigateToPropinas?.wrappedValue = true
                        }
                    }
                } else {
                    showingEdit = true
                }
            }) {
                HStack(alignment: .top) {
                    VStack(alignment: .leading, spacing: 2) {
                        Text(transaction.concept)
                            .font(.body)
                            .bold()
                            .foregroundColor(.primary)
                            .strikethrough(transaction.isCompleted && transaction.type != .tips)
                        
                        if transaction.type == .gp {
                            if let category = transaction.gpCategory {
                                Text(category.rawValue)
                                    .font(.caption2)
                                    .foregroundColor(.secondary)
                            }
                            
                            HStack(spacing: 4) {
                                Text(transaction.paymentMethod.rawValue)
                                .font(.caption2)
                                .foregroundColor(.secondary)
                                
                                if let date = transaction.startDate {
                                    Text("• \(date.formatted(date: .abbreviated, time: .shortened))")
                                        .font(.caption2)
                                        .foregroundColor(.secondary)
                                }
                            }
                        } else if transaction.type != .tips {
                            HStack(spacing: 4) {
                                if transaction.paymentType == .automatic {
                                    Text(transaction.paymentType.rawValue)
                                        .font(.caption2)
                                        .foregroundColor(.secondary)
                                .strikethrough(transaction.isCompleted)
                                } else {
                                    Text("\(transaction.paymentType.rawValue) • \(transaction.paymentMethod.rawValue)")
                                        .font(.caption2)
                                    .foregroundColor(.secondary)
                                    .strikethrough(transaction.isCompleted)
                            }
                            }
                            
                            HStack(spacing: 4) {
                                Text(transaction.periodicity.rawValue)
                                    .font(.caption2)
                                    .foregroundColor(.secondary)
                                    .strikethrough(transaction.isCompleted)
                                
                        if transaction.paymentType == .automatic {
                            if let option = transaction.automaticPaymentOption {
                                if option == .specificDay, let day = transaction.paymentDay {
                                            Text("• Cada día \(day)")
                                        .font(.caption2)
                                        .foregroundColor(.secondary)
                                        .strikethrough(transaction.isCompleted)
                                } else {
                                            Text("• \(option.rawValue)")
                                        .font(.caption2)
                                        .foregroundColor(.secondary)
                                        .strikethrough(transaction.isCompleted)
                                }
                            }
                                }
                            }
                            
                            if transaction.periodicity != .monthly {
                                NextResetDateView(transaction: transaction)
                            }
                        } else if transaction.concept == "Propinas" {
                            // Añadir indicador visual para "Propinas" en ingresos
                            HStack(spacing: 4) {
                                Text("Pulse para ver detalle")
                                    .font(.caption2)
                                    .foregroundColor(.secondary)
                                Image(systemName: "chevron.right")
                                    .foregroundColor(.secondary)
                                    .font(.caption2)
                            }
                        }
                    }
                    
                    Spacer()
                    
                    VStack(alignment: .trailing, spacing: 2) {
                        Text(String(format: "%.2f €", transaction.amount))
                            .font(.subheadline)
                            .bold()
                            .foregroundColor(.yellow)
                            .strikethrough(transaction.isCompleted && transaction.type != .tips)
                    }
                }
                .contentShape(Rectangle())
            }
            .buttonStyle(PlainButtonStyle())
            .padding(.leading, transaction.type == .tips ? 28 : 0)
        }
        .padding(.vertical, 2)
        .sheet(isPresented: $showingEdit) {
            if transaction.type == .gp {
                EditGPTransactionView(transaction: transaction)
            } else {
            EditTransactionView(transaction: transaction)
            }
        }
    }
}

struct TransactionListView: View {
    @Binding var transactions: [Transaction]
    let title: String
    var pendingTotal: Double?
    var completedTotal: Double?
    var total: Double?
    let type: TransactionType
    @EnvironmentObject var viewModel: FinanceViewModel
    @Environment(\.presentationMode) var presentationMode
    @State private var showingAddTransaction = false
    @State private var showingResetConfirmation = false
    @Binding var selectedTab: Int
    var navigateToGastosDiarios: Binding<Bool>? = nil
    var navigateToPropinas: Binding<Bool>? = nil
    var navigateToSuscripciones: Binding<Bool>? = nil
    
    private func formatCurrentMonth() -> String {
        let formatter = DateFormatter()
        formatter.locale = Locale(identifier: "es_ES")
        formatter.dateFormat = "MMMM"
        
        // Obtener la fecha actual
        let currentDate = Date()
        
        // Si se debe mostrar el mes siguiente (después de un reset)
        if viewModel.showNextMonth {
            let calendar = Calendar.current
            if let nextMonth = calendar.date(byAdding: .month, value: 1, to: currentDate) {
                return formatter.string(from: nextMonth).uppercased()
            }
        }
        
        return formatter.string(from: currentDate).uppercased()
    }
    
    private func formatCurrentYear() -> String {
        let formatter = DateFormatter()
        formatter.dateFormat = "yyyy"
        
        // Obtener la fecha actual
        let currentDate = Date()
        
        // Si se debe mostrar el mes siguiente y es diciembre
        if viewModel.showNextMonth {
            let calendar = Calendar.current
            let currentMonth = calendar.component(.month, from: currentDate)
            
            if currentMonth == 12 {
                if let nextYear = calendar.date(byAdding: .year, value: 1, to: currentDate) {
                    return formatter.string(from: nextYear)
                }
            }
        }
        
        return formatter.string(from: currentDate)
    }
    
    private func sortTransactions(_ transactions: [Transaction]) -> [Transaction] {
        return transactions.sorted { t1, t2 in
            // Primero los pagos manuales
            if t1.paymentType == .manual && t2.paymentType == .automatic {
                return true
            }
            if t1.paymentType == .automatic && t2.paymentType == .manual {
                return false
            }
            
            // Si ambos son automáticos, ordenar por día
            if t1.paymentType == .automatic && t2.paymentType == .automatic {
                if let option1 = t1.automaticPaymentOption, let option2 = t2.automaticPaymentOption {
                    // Último día laboral siempre primero
                    if option1 == .lastWorkday && option2 != .lastWorkday {
                        return true
                    }
                    if option1 != .lastWorkday && option2 == .lastWorkday {
                        return false
                    }
                    
                    // Luego día 1
                    if option1 == .specificDay && t1.paymentDay == 1 && 
                       (option2 != .specificDay || t2.paymentDay != 1) {
                        return true
                    }
                    if option2 == .specificDay && t2.paymentDay == 1 && 
                       (option1 != .specificDay || t1.paymentDay != 1) {
                        return false
                    }
                    
                    // Luego primer día laboral
                    if option1 == .firstWorkday && option2 != .firstWorkday {
                        return true
                    }
                    if option1 != .firstWorkday && option2 == .firstWorkday {
                        return false
                    }
                    
                    // Finalmente, ordenar por día específico
                    if option1 == .specificDay && option2 == .specificDay {
                        return (t1.paymentDay ?? 0) < (t2.paymentDay ?? 0)
                    }
                }
            }
            
            return false
        }
    }
    
    var body: some View {
        List {
            Section(header: Text("Pendientes")) {
                ForEach(sortTransactions(transactions.filter { transaction in
                    // Filtrar transacciones pendientes que no sean suscripciones ni Gastos Diarios
                    let isPending = !transaction.isCompleted && 
                                   transaction.concept != "Suscripciones" && 
                                   transaction.concept != "Gastos Diarios"
                    
                    // Para periodicidades no mensuales, verificar si debe mostrarse en el mes actual
                    if transaction.periodicity != .monthly {
                        // Si tenemos un mes específico que mostrar (showNextMonth = true)
                        if viewModel.showNextMonth {
                            // Determinar si coincide con la próxima fecha de aparición
                            if let lastReset = transaction.lastResetDate {
                                let calendar = Calendar.current
                                var monthsToAdd = 1
                                
                                switch transaction.periodicity {
                                case .weekly:
                                    // Para periodicidad semanal, calcular próxima semana
                                    if let nextDate = calendar.date(byAdding: .day, value: 7, to: lastReset) {
                                        // Obtener el mes y año que se muestra en la cabecera
                                        let currentDate = Date()
                                        let nextMonth = calendar.date(byAdding: .month, value: 1, to: currentDate)!
                                        
                                        let nextDateComponents = calendar.dateComponents([.day, .month, .year], from: nextDate)
                                        let nextMonthComponents = calendar.dateComponents([.month, .year], from: nextMonth)
                                        
                                        // Solo mostrar si la próxima semana cae en el mes que se muestra
                                        return isPending && 
                                               nextDateComponents.month == nextMonthComponents.month && 
                                               nextDateComponents.year == nextMonthComponents.year
                                    }
                                    return isPending
                                case .monthly: monthsToAdd = 1
                                case .bimonthly: monthsToAdd = 2
                                case .quarterly: monthsToAdd = 3
                                case .semiannual: monthsToAdd = 6
                                case .annual: monthsToAdd = 12
                                case .biannual: monthsToAdd = 24
                                }
                                
                                // Calcular la próxima fecha de aparición
                                if let nextDate = calendar.date(byAdding: .month, value: monthsToAdd, to: lastReset) {
                                    // Obtener el mes y año que se muestra en la cabecera
                                    let currentDate = Date()
                                    let nextMonth = calendar.date(byAdding: .month, value: 1, to: currentDate)!
                                    
                                    // Comparar componentes de mes y año
                                    let nextDateComponents = calendar.dateComponents([.month, .year], from: nextDate)
                                    let nextMonthComponents = calendar.dateComponents([.month, .year], from: nextMonth)
                                    
                                    // Solo mostrar si coincide con la próxima aparición
                                    return isPending && 
                                           nextDateComponents.month == nextMonthComponents.month && 
                                           nextDateComponents.year == nextMonthComponents.year
                                }
                            }
                            
                            // Si no se puede determinar la próxima fecha, no mostrar
                            return false
                        } else {
                            // Mes actual: mostrar transacciones pendientes normalmente
                            return isPending
                        }
                    }
                    
                    // Para periodicidad mensual o si no se pudo determinar, mostrar normalmente
                    return isPending
                })) { transaction in
                    TransactionRow(transaction: transaction, selectedTab: $selectedTab, navigateToGastosDiarios: navigateToGastosDiarios, navigateToPropinas: navigateToPropinas)
                }
                
                let hasPendingTransactions = !transactions.filter { !$0.isCompleted && $0.concept != "Suscripciones" && $0.concept != "Gastos Diarios" }.isEmpty
                let hasPendingSubscriptions = type == .expense && viewModel.subscriptions.filter { !$0.isCompleted }.reduce(0) { $0 + $1.amount } > 0
                
                if !hasPendingTransactions && !hasPendingSubscriptions {
                    Text(title == "Suscripciones" ? "Ya está todo pagado" : "No hay nada pendiente de cobrar")
                        .font(.subheadline)
                        .foregroundColor(.secondary)
                        .frame(maxWidth: .infinity, alignment: .center)
                        .padding(.vertical, 8)
                }
                
                // Solo mostrar suscripciones pendientes, no las que tienen check
                if type == .expense {
                    let pendingSubscriptionsTotal = viewModel.subscriptions.filter { !$0.isCompleted }.reduce(0) { $0 + $1.amount }
                    if pendingSubscriptionsTotal > 0 {
                        Button(action: {
                            withAnimation {
                                selectedTab = 3 // Navegar a la pestaña Más
                                // Primero desactivamos para asegurar que se active correctamente después
                                navigateToSuscripciones?.wrappedValue = false
                                DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) {
                                    navigateToSuscripciones?.wrappedValue = true
                                }
                            }
                        }) {
                        HStack {
                            Text("Suscripciones pendientes de pagar")
                                .font(.subheadline)
                                .foregroundColor(.secondary)
                            Spacer()
                            HStack {
                                Text(String(format: "%.2f €", pendingSubscriptionsTotal))
                                    .font(.title3)
                                    .bold()
                                    .foregroundColor(.red)
                                Image(systemName: "chevron.right")
                                    .foregroundColor(.secondary)
                                    .font(.caption)
                            }
                        }
                    }
                }
            }
            
            if let pendingTotal = pendingTotal, title != "Suscripciones" {
                Section {
                    HStack {
                        Text("Total pendiente")
                        Spacer()
                        if type == .expense {
                            // Calcular manualmente las transacciones pendientes para tener el valor correcto
                            let pendingExpensesSum = transactions.filter { !$0.isCompleted && $0.concept != "Suscripciones" && $0.concept != "Gastos Diarios" }.reduce(0) { $0 + $1.amount }
                            let pendingSubscriptionsTotal = viewModel.pendingSubscriptions
                            
                            // Mostrar la suma correcta
                            let totalPending = pendingExpensesSum + pendingSubscriptionsTotal
                            Text(String(format: "%.2f €", totalPending))
                                .font(.title3)
                                .bold()
                                .foregroundColor(.red)
                        } else {
                            Text(String(format: "%.2f €", pendingTotal))
                                .font(.title3)
                                .bold()
                                .foregroundColor(.red)
                        }
                    }
                }
            }
            
            Section(header: Text("Completados")) {
                ForEach(sortTransactions(transactions.filter { transaction in
                    // Filtrar transacciones completadas que no sean suscripciones ni Gastos Diarios
                    let isCompleted = transaction.isCompleted && 
                                     transaction.concept != "Suscripciones" && 
                                     transaction.concept != "Gastos Diarios"
                    
                    // Para periodicidades no mensuales, verificar si debe mostrarse en el mes actual
                    if transaction.periodicity != .monthly {
                        // Si tenemos un mes específico que mostrar (showNextMonth = true)
                        if viewModel.showNextMonth {
                            // Para periodicidad semanal, manejo especial
                            if transaction.periodicity == .weekly {
                                // Verificar si la última reset fecha está en el mes actual
                                // o si la próxima semana cae en el mes actual
                                let lastResetComponents = Calendar.current.dateComponents([.month, .year], from: transaction.lastResetDate ?? Date())
                                let currentComponents = Calendar.current.dateComponents([.month, .year], from: Date())
                                
                                // Si el último reset fue en este mes, mostrar
                                if lastResetComponents.month == currentComponents.month && 
                                   lastResetComponents.year == currentComponents.year {
                                    return isCompleted
                                }
                                
                                // Verificar si la próxima semana aún está en este mes
                                if let nextDate = Calendar.current.date(byAdding: .day, value: 7, to: transaction.lastResetDate ?? Date()) {
                                    let nextDateComponents = Calendar.current.dateComponents([.month, .year], from: nextDate)
                                    return isCompleted && 
                                           nextDateComponents.month == currentComponents.month && 
                                           nextDateComponents.year == currentComponents.year
                                }
                                return false
                            }
                            
                            // Obtener el mes y año que se muestra en la cabecera
                            let currentDate = Date()
                            let nextMonth = Calendar.current.date(byAdding: .month, value: 1, to: currentDate)!
                            
                            // Comparar componentes de mes y año
                            let lastResetComponents = Calendar.current.dateComponents([.month, .year], from: transaction.lastResetDate ?? Date())
                            let nextMonthComponents = Calendar.current.dateComponents([.month, .year], from: nextMonth)
                            
                            // Solo mostrar si fue completada en el mes que se muestra
                            return isCompleted && 
                                   lastResetComponents.month == nextMonthComponents.month && 
                                   lastResetComponents.year == nextMonthComponents.year
                        } else {
                            // Mostrar solo las completadas en el mes actual
                            if let lastReset = transaction.lastResetDate {
                                let calendar = Calendar.current
                                let currentDate = Date()
                                
                                // Para periodicidad semanal, manejo especial
                                if transaction.periodicity == .weekly {
                                    // Verificar si la última reset fecha está en el mes actual
                                    // o si la próxima semana cae en el mes actual
                                    let lastResetComponents = calendar.dateComponents([.month, .year], from: lastReset)
                                    let currentComponents = calendar.dateComponents([.month, .year], from: currentDate)
                                    
                                    // Si el último reset fue en este mes, mostrar
                                    if lastResetComponents.month == currentComponents.month && 
                                       lastResetComponents.year == currentComponents.year {
                                        return isCompleted
                                    }
                                    
                                    // Verificar si la próxima semana aún está en este mes
                                    if let nextDate = calendar.date(byAdding: .day, value: 7, to: lastReset) {
                                        let nextDateComponents = calendar.dateComponents([.month, .year], from: nextDate)
                                        return isCompleted && 
                                               nextDateComponents.month == currentComponents.month && 
                                               nextDateComponents.year == currentComponents.year
                                    }
                                    return false
                                }
                                
                                // Comparar componentes de mes y año
                                let lastResetComponents = calendar.dateComponents([.month, .year], from: lastReset)
                                let currentComponents = calendar.dateComponents([.month, .year], from: currentDate)
                                
                                // Solo mostrar si fue completada en el mes actual
                                return isCompleted && 
                                       lastResetComponents.month == currentComponents.month && 
                                       lastResetComponents.year == currentComponents.year
                            }
                            
                            // Si no tiene lastResetDate, mostrar normalmente
                            return isCompleted
                        }
                    }
                    
                    // Para periodicidad mensual, mostrar normalmente
                    return isCompleted
                })) { transaction in
                    TransactionRow(transaction: transaction, selectedTab: $selectedTab, navigateToGastosDiarios: navigateToGastosDiarios, navigateToPropinas: navigateToPropinas)
                }
                
                // Mostrar suscripciones completadas con el sumatorio
                if type == .expense {
                    // Añadir enlace a Gastos Diarios
                    let gpTotal = viewModel.gpTransactions.reduce(0) { $0 + $1.amount }
                    if gpTotal > 0 {
                        Button(action: {
                            withAnimation {
                                selectedTab = 3 // Navegar a la pestaña Más
                                // Primero desactivamos para asegurar que se active correctamente después
                                navigateToGastosDiarios?.wrappedValue = false
                                DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) {
                                    navigateToGastosDiarios?.wrappedValue = true
                                }
                            }
                        }) {
                            HStack(spacing: 8) {
                                HStack {
                                    Text("Gastos diarios")
                                        .font(.subheadline)
                                        .foregroundColor(.secondary)
                                    Spacer()
                                    HStack {
                                        Text(String(format: "%.2f €", gpTotal))
                                            .font(.title3)
                                            .bold()
                                            .foregroundColor(.blue)
                                        Image(systemName: "chevron.right")
                                            .foregroundColor(.secondary)
                                            .font(.caption)
                                    }
                                }
                                .padding(.vertical, 2)
                            }
                        }
                    }
                    
                    let completedSubscriptionsTotal = viewModel.completedSubscriptions
                    if completedSubscriptionsTotal > 0 {
                        Button(action: {
                            withAnimation {
                                selectedTab = 3 // Navegar a la pestaña Más
                                // Primero desactivamos para asegurar que se active correctamente después
                                navigateToSuscripciones?.wrappedValue = false
                                DispatchQueue.main.asyncAfter(deadline: .now() + 0.3) {
                                    navigateToSuscripciones?.wrappedValue = true
                                }
                            }
                        }) {
                            HStack(spacing: 8) {
                                HStack {
                                    Text("Suscripciones pagadas")
                                        .font(.subheadline)
                                        .foregroundColor(.secondary)
                                    Spacer()
                                    HStack {
                                        Text(String(format: "%.2f €", completedSubscriptionsTotal))
                                            .font(.title3)
                                            .bold()
                                            .foregroundColor(.green)
                                        Image(systemName: "chevron.right")
                                            .foregroundColor(.secondary)
                                            .font(.caption)
                                    }
                                }
                                .padding(.vertical, 2)
                            }
                        }
                    } else if title == "Suscripciones" {
                        Text("Aún no hay ninguna suscripción pagada")
                                .font(.subheadline)
                                .foregroundColor(.secondary)
                            .frame(maxWidth: .infinity, alignment: .center)
                            .padding(.vertical, 8)
                    }
                }
            }
            
            if let completedTotal = completedTotal, title != "Suscripciones" {
                Section {
                    HStack {
                        Text(type == .income ? "Total cobrado" : "Total pagados")
                        Spacer()
                        if type == .expense {
                            // En la pestaña de gastos, mostrar el total de gastos completados + suscripciones completadas + GP
                            let completedSubscriptionsTotal = viewModel.completedSubscriptions
                            let gpExpense = viewModel.expenses.first(where: { $0.concept == "Gastos Diarios" })?.amount ?? 0
                            let totalCompleted = completedTotal + completedSubscriptionsTotal + gpExpense
                            Text(String(format: "%.2f €", totalCompleted))
                                .font(.title3)
                                .bold()
                                .foregroundColor(.green)
                        } else {
                            Text(String(format: "%.2f €", completedTotal))
                                .font(.title3)
                                .bold()
                                .foregroundColor(type == .income ? .green : .red)
                        }
                    }
                }
            }
            
            if let total = total {
                Section {
                    HStack {
                        Text("Total")
                        Spacer()
                        if type == .expense {
                            if title == "Suscripciones" {
                                // En suscripciones, mostrar la suma de completadas + pendientes
                                let completedSubscriptionsTotal = viewModel.completedSubscriptions
                                let pendingSubscriptionsTotal = viewModel.pendingSubscriptions
                                let finalTotal = completedSubscriptionsTotal + pendingSubscriptionsTotal
                                
                                Text(String(format: "%.2f €", finalTotal))
                                .font(.title3)
                                .bold()
                                    .foregroundColor(Color.blue.opacity(0.7))
                            } else {
                                // Calcular total como suma de "Total pendiente" + "Total pagados"
                                let pendingExpensesSum = transactions.filter { !$0.isCompleted && $0.concept != "Suscripciones" && $0.concept != "Gastos Diarios" }.reduce(0) { $0 + $1.amount }
                                let pendingSubscriptionsTotal = viewModel.pendingSubscriptions
                                let totalPending = pendingExpensesSum + pendingSubscriptionsTotal
                                
                                let completedSubscriptionsTotal = viewModel.completedSubscriptions
                                let gpExpense = viewModel.expenses.first(where: { $0.concept == "Gastos Diarios" })?.amount ?? 0
                                let totalCompleted = (completedTotal ?? 0) + completedSubscriptionsTotal + gpExpense
                                
                                let finalTotal = totalPending + totalCompleted
                                
                                Text(String(format: "%.2f €", finalTotal))
                                    .font(.title3)
                                    .bold()
                                    .foregroundColor(Color.blue.opacity(0.7))
                            }
                        } else {
                            Text(String(format: "%.2f €", total))
                                .font(.title3)
                                .bold()
                                .foregroundColor(type == .income ? Color.blue.opacity(0.7) : .red)
                        }
                    }
                }
            }
        }
        .listStyle(.plain)
        .navigationTitle(title)
        .navigationBarTitleDisplayMode(.inline)
        .toolbar {
            if title != "Ingresos" && title != "Gastos" {
                ToolbarItem(placement: .principal) {
                    VStack(spacing: 2) {
                        Text(title)
                            .font(.title2)
                            .bold()
                            .foregroundColor(.white)
                        Text("\(formatCurrentMonth()) \(formatCurrentYear())")
                            .font(.caption)
                            .foregroundColor(.white.opacity(0.7))
                    }
                    .frame(maxWidth: .infinity)
                }
            }
            
            // Solo mostramos el botón + si no estamos en las vistas principales de Ingresos o Gastos
            // ya que esas vistas ya tienen su propio botón en ContentView
            if title != "Ingresos" && title != "Gastos" && title != "Suscripciones" && title != "Gastos diarios" {
                ToolbarItem(placement: .navigationBarTrailing) {
                    Button(action: { showingAddTransaction = true }) {
                        Image(systemName: "plus")
                    }
                }
            }
        }
        .sheet(isPresented: $showingAddTransaction) {
            if type == .gp {
                AddGPTransactionView()
            } else {
            AddTransactionView(type: type)
            }
        }
        .alert("Atención", isPresented: $showingResetConfirmation) {
            Button("Cancelar", role: .cancel) { }
            Button("Restablecer", role: .destructive) {
                // Ahora el manejo del showNextMonth está en el viewModel
                viewModel.resetCompletedTransactions()
            }
        } message: {
            Text("Se restablecerán todos los conceptos a su estado original. ¿Está seguro de querer realizar esta operación?")
        }
    }
}

struct AddGPTransactionView: View {
    @EnvironmentObject var viewModel: FinanceViewModel
    @Environment(\.presentationMode) var presentationMode
    
    @State private var amount: String = ""
    @State private var concept: String = ""
    @State private var paymentMethod: PaymentMethod = .card
    @State private var category: GPCategory = .otros
    @State private var date: Date = Date()
    
    var body: some View {
        NavigationView {
            Form {
                Section(header: Text("Información básica")) {
                    TextField("Concepto", text: $concept)
                    HStack {
                        TextField("Cantidad", text: $amount)
                            .keyboardType(.decimalPad)
                        Text("€")
                            .foregroundColor(.secondary)
        }
                }
                
                Section(header: Text("Detalles")) {
                    Picker("Categoría", selection: $category) {
                        ForEach(GPCategory.allCases, id: \.self) { category in
                            Text(category.rawValue).tag(category)
                        }
                    }
                    
                    Picker("Método de pago", selection: $paymentMethod) {
                        ForEach(PaymentMethod.allCases, id: \.self) { method in
                            Text(method.rawValue).tag(method)
                        }
                    }
                    
                    DatePicker("Fecha y hora",
                             selection: $date,
                             displayedComponents: [.date, .hourAndMinute])
                        .environment(\.locale, Locale(identifier: "es_ES"))
                }
            }
            .navigationTitle("Nuevo gasto GP")
            .navigationBarItems(
                leading: Button("Cancelar") {
                    presentationMode.wrappedValue.dismiss()
                },
                trailing: Button("Guardar") {
                    if let amount = Double(amount),
                       !concept.isEmpty {
                        let transaction = Transaction(
                            amount: amount,
                            concept: concept,
                            type: .gp,
                            paymentMethod: paymentMethod,
                            startDate: date,
                            gpCategory: category
                        )
                        
                        viewModel.addTransaction(transaction)
                        presentationMode.wrappedValue.dismiss()
                    }
                }
            )
        }
    }
}

struct GPTransactionListView: View {
    @Binding var transactions: [Transaction]
    @EnvironmentObject var viewModel: FinanceViewModel
    @State private var showingAddTransaction = false
    @Binding var selectedTab: Int
    
    private func formatCurrentMonth() -> String {
        let formatter = DateFormatter()
        formatter.locale = Locale(identifier: "es_ES")
        formatter.dateFormat = "MMMM"
        return formatter.string(from: Date()).uppercased()
    }
    
    private func formatCurrentYear() -> String {
        let formatter = DateFormatter()
        formatter.dateFormat = "yyyy"
        return formatter.string(from: Date())
    }
    
    var body: some View {
        List {
            ForEach(transactions.sorted(by: { ($0.startDate ?? Date()) > ($1.startDate ?? Date()) })) { transaction in
                TransactionRow(transaction: transaction, selectedTab: $selectedTab)
            }
            
            if !transactions.isEmpty {
                Section {
                HStack {
                    Text("Total")
                    Spacer()
                        Text(String(format: "%.2f €", transactions.reduce(0) { $0 + $1.amount }))
                            .font(.title3)
                        .bold()
                            .foregroundColor(Color.blue.opacity(0.7))
                }
            }
        }
        }
        .listStyle(.plain)
        .navigationBarTitleDisplayMode(.inline)
        .toolbar {
            ToolbarItem(placement: .principal) {
                VStack(spacing: 2) {
                    Text("Gastos diarios")
                        .font(.title2)
                        .bold()
                        .foregroundColor(.white)
                    Text("\(formatCurrentMonth()) \(formatCurrentYear())")
                        .font(.caption)
                        .foregroundColor(.white.opacity(0.7))
                }
                .frame(maxWidth: .infinity)
            }
            
            // Eliminamos por completo el botón +, ya que esta vista siempre es "Gastos diarios"
            // y el botón debe estar en un nivel superior
        }
        .sheet(isPresented: $showingAddTransaction) {
            AddGPTransactionView()
        }
    }
} 
} 

