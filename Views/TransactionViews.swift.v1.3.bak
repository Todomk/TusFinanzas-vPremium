import SwiftUI

struct AddTransactionView: View {
    let type: TransactionType
    @EnvironmentObject var viewModel: FinanceViewModel
    @Environment(\.presentationMode) var presentationMode
    
    @State private var amount: String = ""
    @State private var concept: String = ""
    @State private var periodicity: Periodicity = .monthly
    @State private var paymentType: PaymentType = .manual
    @State private var paymentMethod: PaymentMethod = .bank
    @State private var paymentDay: String = "1"
    @State private var startDate: Date = Date()
    @State private var showingDatePicker = false
    
    var body: some View {
        NavigationView {
            Form {
                Section(header: Text("Información básica")) {
                    TextField("Concepto", text: $concept)
                    HStack {
                    TextField("Cantidad", text: $amount)
                        .keyboardType(.decimalPad)
                        Text("€")
                            .foregroundColor(.secondary)
                    }
                }
                
                Section(header: Text("Configuración")) {
                    Picker("Periodicidad", selection: $periodicity) {
                        ForEach(Periodicity.allCases, id: \.self) { period in
                            Text(period.rawValue).tag(period)
                        }
                    }
                    
                    Picker("Tipo de pago", selection: $paymentType) {
                        ForEach(PaymentType.allCases, id: \.self) { type in
                            Text(type.rawValue).tag(type)
                        }
                    }
                    
                    if paymentType == .automatic {
                        Picker("Día del mes", selection: $paymentDay) {
                            Text("Primer día laboral").tag("first")
                            Text("Último día laboral").tag("last")
                            Text("Día específico semanal").tag("weekday")
                            Text("Último día laboral semanal").tag("lastWeekday")
                            ForEach(1...31, id: \.self) { day in
                                Text("\(day)").tag(String(day))
                        }
                    }
                }
                
                    Picker("Método de pago", selection: $paymentMethod) {
                        ForEach(PaymentMethod.allCases, id: \.self) { method in
                            Text(method.rawValue).tag(method)
                        }
                    }
                    
                    if type != .income {
                        Button(action: { showingDatePicker = true }) {
                            HStack {
                                Text("Fecha de inicio")
                                Spacer()
                                Text(startDate.formatted(date: .abbreviated, time: .omitted))
                                    .foregroundColor(.secondary)
                            }
                        }
                    }
                }
            }
            .navigationTitle("Nueva transacción")
            .navigationBarItems(
                leading: Button("Cancelar") {
                    presentationMode.wrappedValue.dismiss()
                },
                trailing: Button("Guardar") {
                    if let amount = Double(amount),
                       !concept.isEmpty {
                        var transaction = Transaction(
                            amount: amount,
                            concept: concept,
                            type: type,
                            periodicity: periodicity,
                            paymentType: paymentType,
                            paymentMethod: paymentMethod
                        )
                        
                        if type != .income {
                            transaction.startDate = startDate
                        }
                        
                        if paymentType == .automatic {
                            if paymentDay == "first" {
                                transaction.automaticPaymentOption = .firstWorkday
                                transaction.paymentDay = nil
                            } else if paymentDay == "last" {
                                transaction.automaticPaymentOption = .lastWorkday
                                transaction.paymentDay = nil
                            } else if paymentDay == "weekday" {
                                transaction.automaticPaymentOption = .specificWeekDay
                                transaction.paymentDay = nil
                                transaction.weekDay = .friday  // Día predeterminado
                            } else if paymentDay == "lastWeekday" {
                                transaction.automaticPaymentOption = .lastWorkDayOfWeek
                                transaction.paymentDay = nil
                            } else {
                                transaction.automaticPaymentOption = .specificDay
                                transaction.paymentDay = Int(paymentDay)
                            }
                        }
                        
                        viewModel.addTransaction(transaction)
                        presentationMode.wrappedValue.dismiss()
                    }
                }
            )
            .sheet(isPresented: $showingDatePicker) {
                DatePicker("Selecciona fecha de inicio",
                          selection: $startDate,
                          displayedComponents: .date)
                    .datePickerStyle(.graphical)
                    .presentationDetents([.medium])
                    .environment(\.locale, Locale(identifier: "es_ES"))
            }
        }
    }
}

struct EditTransactionView: View {
    let transaction: Transaction
    @EnvironmentObject var viewModel: FinanceViewModel
    @Environment(\.presentationMode) var presentationMode
    
    @State private var amount: String
    @State private var concept: String
    @State private var periodicity: Periodicity
    @State private var paymentType: PaymentType
    @State private var paymentMethod: PaymentMethod
    @State private var paymentDay: String = "1"
    @State private var startDate: Date
    @State private var showingDeleteConfirmation = false
    @State private var showingDatePicker = false
    
    init(transaction: Transaction) {
        self.transaction = transaction
        _amount = State(initialValue: String(transaction.amount))
        _concept = State(initialValue: transaction.concept)
        _periodicity = State(initialValue: transaction.periodicity)
        _paymentType = State(initialValue: transaction.paymentType)
        _paymentMethod = State(initialValue: transaction.paymentMethod)
        _startDate = State(initialValue: transaction.startDate ?? Date())
        
        // Inicialización del día de pago
        if let day = transaction.paymentDay {
            _paymentDay = State(initialValue: String(day))
        } else if let option = transaction.automaticPaymentOption {
            switch option {
            case .firstWorkday:
                _paymentDay = State(initialValue: "first")
            case .lastWorkday:
                _paymentDay = State(initialValue: "last")
            case .specificDay:
                _paymentDay = State(initialValue: "1")
            case .specificWeekDay:
                _paymentDay = State(initialValue: "weekday")
            case .lastWorkDayOfWeek:
                _paymentDay = State(initialValue: "lastWeekday")
            }
        }
    }
    
    var body: some View {
        NavigationView {
            Form {
                Section(header: Text("Información básica")) {
                    TextField("Concepto", text: $concept)
                    HStack {
                        TextField("Cantidad", text: $amount)
                            .keyboardType(.decimalPad)
                        Text("€")
                            .foregroundColor(.secondary)
                    }
                }
                
                Section(header: Text("Configuración")) {
                    Picker("Periodicidad", selection: $periodicity) {
                        ForEach(Periodicity.allCases, id: \.self) { period in
                            Text(period.rawValue).tag(period)
                        }
                    }
                    
                    Picker("Tipo de pago", selection: $paymentType) {
                        ForEach(PaymentType.allCases, id: \.self) { type in
                            Text(type.rawValue).tag(type)
                        }
                    }
                    
                    if paymentType == .automatic {
                        Picker("Día del mes", selection: $paymentDay) {
                            Text("Primer día laboral").tag("first")
                            Text("Último día laboral").tag("last")
                            Text("Día específico semanal").tag("weekday")
                            Text("Último día laboral semanal").tag("lastWeekday")
                            ForEach(1...31, id: \.self) { day in
                                Text("\(day)").tag(String(day))
                            }
                        }
                        
                        if paymentDay == "weekday" && periodicity == .weekly {
                            Picker("Día de la semana", selection: Binding<WeekDay>(
                                get: { transaction.weekDay ?? .friday },
                                set: { _ in }
                            )) {
                                ForEach(WeekDay.allCases, id: \.self) { weekday in
                                    Text(weekday.description).tag(weekday)
                                }
                            }
                            .disabled(true) // Deshabilitado porque no podemos modificar directamente
                        }
                    }
                    
                    Picker("Método de pago", selection: $paymentMethod) {
                        ForEach(PaymentMethod.allCases, id: \.self) { method in
                            Text(method.rawValue).tag(method)
                        }
                    }
                    
                    if transaction.type != .income {
                        Button(action: { showingDatePicker = true }) {
                            HStack {
                                Text("Fecha de inicio")
                                Spacer()
                                Text(startDate.formatted(date: .abbreviated, time: .omitted))
                                    .foregroundColor(.secondary)
                            }
                        }
                    }
                }
                
                Section {
                    Button(action: { showingDeleteConfirmation = true }) {
                        HStack {
                            Spacer()
                            Text("Eliminar transacción")
                                .foregroundColor(.red)
                            Spacer()
                        }
                    }
                }
            }
            .navigationTitle("Editar transacción")
            .navigationBarItems(
                leading: Button("Cancelar") {
                    presentationMode.wrappedValue.dismiss()
                },
                trailing: Button("Guardar") {
                    if let amount = Double(amount),
                       !concept.isEmpty {
                        var updatedTransaction = transaction
                        updatedTransaction.amount = amount
                        updatedTransaction.concept = concept
                        updatedTransaction.periodicity = periodicity
                        updatedTransaction.paymentType = paymentType
                        updatedTransaction.paymentMethod = paymentMethod
                        
                        if transaction.type != .income {
                            updatedTransaction.startDate = startDate
                        }
                        
                        if paymentType == .automatic {
                            if paymentDay == "first" {
                                updatedTransaction.automaticPaymentOption = .firstWorkday
                                updatedTransaction.paymentDay = nil
                            } else if paymentDay == "last" {
                                updatedTransaction.automaticPaymentOption = .lastWorkday
                                updatedTransaction.paymentDay = nil
                            } else if paymentDay == "weekday" {
                                updatedTransaction.automaticPaymentOption = .specificWeekDay
                                updatedTransaction.paymentDay = nil
                                updatedTransaction.weekDay = .friday  // Día predeterminado
                            } else if paymentDay == "lastWeekday" {
                                updatedTransaction.automaticPaymentOption = .lastWorkDayOfWeek
                                updatedTransaction.paymentDay = nil
                            } else {
                                updatedTransaction.automaticPaymentOption = .specificDay
                                updatedTransaction.paymentDay = Int(paymentDay)
                            }
                        } else {
                            updatedTransaction.automaticPaymentOption = nil
                            updatedTransaction.paymentDay = nil
                        }
                        
                        viewModel.deleteTransaction(transaction)
                        viewModel.addTransaction(updatedTransaction)
                        presentationMode.wrappedValue.dismiss()
                    }
                }
            )
            .alert("¿Estás seguro?", isPresented: $showingDeleteConfirmation) {
                Button("Cancelar", role: .cancel) { }
                Button("Eliminar", role: .destructive) {
                    viewModel.deleteTransaction(transaction)
                    presentationMode.wrappedValue.dismiss()
                }
            } message: {
                Text("¿Quieres eliminar esta transacción?")
            }
            .sheet(isPresented: $showingDatePicker) {
                DatePicker("Selecciona fecha de inicio",
                          selection: $startDate,
                          displayedComponents: .date)
                    .datePickerStyle(.graphical)
                    .presentationDetents([.medium])
                    .environment(\.locale, Locale(identifier: "es_ES"))
            }
        }
    }
}

struct TransactionSettingsView: View {
    let transaction: Transaction
    @EnvironmentObject var viewModel: FinanceViewModel
    @Environment(\.presentationMode) var presentationMode
    @State private var selectedPaymentMethod: PaymentMethod
    @State private var isAutomaticPayment: Bool
    @State private var paymentDay: Int
    @State private var selectedAutomaticOption: AutomaticPaymentOption
    
    init(transaction: Transaction) {
        self.transaction = transaction
        _selectedPaymentMethod = State(initialValue: transaction.paymentMethod)
        _isAutomaticPayment = State(initialValue: transaction.paymentType == .automatic)
        _paymentDay = State(initialValue: transaction.paymentDay ?? 1)
        _selectedAutomaticOption = State(initialValue: transaction.automaticPaymentOption ?? .specificDay)
    }
    
    var body: some View {
        NavigationView {
            Form {
                Section(header: Text("Método de pago")) {
                    Picker("Método", selection: $selectedPaymentMethod) {
                        Text("Efectivo").tag(PaymentMethod.cash)
                        Text("Transferencia").tag(PaymentMethod.bank)
                        Text("Tarjeta").tag(PaymentMethod.card)
                    }
                }
                
                Section(header: Text("Programación de pago")) {
                    Toggle("Pago automático", isOn: $isAutomaticPayment)
                    
                    if isAutomaticPayment {
                        Picker("Opción de pago automático", selection: $selectedAutomaticOption) {
                            ForEach(AutomaticPaymentOption.allCases, id: \.self) { option in
                                Text(option.rawValue).tag(option)
                            }
                        }
                        
                        if selectedAutomaticOption == .specificDay {
                            Stepper("Día del mes: \(paymentDay)", value: $paymentDay, in: 1...31)
                        }
                    }
                }
            }
            .navigationTitle("Configuración")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .navigationBarTrailing) {
                    Button("Guardar") {
                        var updatedTransaction = transaction
                        updatedTransaction.paymentMethod = selectedPaymentMethod
                        updatedTransaction.paymentType = isAutomaticPayment ? .automatic : .manual
                        updatedTransaction.paymentDay = isAutomaticPayment ? paymentDay : nil
                        updatedTransaction.automaticPaymentOption = isAutomaticPayment ? selectedAutomaticOption : nil
                        
                        viewModel.deleteTransaction(transaction)
                        viewModel.addTransaction(updatedTransaction)
                        presentationMode.wrappedValue.dismiss()
                    }
                }
                ToolbarItem(placement: .navigationBarLeading) {
                    Button("Cancelar") {
                        presentationMode.wrappedValue.dismiss()
                    }
                }
            }
        }
    }
}

struct EditGPTransactionView: View {
    let transaction: Transaction
    @EnvironmentObject var viewModel: FinanceViewModel
